# Apple Calendar / Reminders (iCloud CalDAV)
# 1) appleid.apple.com → Sign-In and Security → App-Specific Passwords → generate one
# 2) Paste Apple ID email + that password below (NOT your normal Apple password)
APPLE_ID=
APPLE_APP_PASSWORD=
# Optional override (defaults to https://caldav.icloud.com)
APPLE_CALDAV_URL=https://caldav.icloud.com

# Apple Photos — Shared Album link (either style works)
# Preferred: Photos → album → Share → Copy Link
#   https://photos.icloud.com/shared/album/TOKEN
# Classic Public Website also works:
#   https://www.icloud.com/sharedalbum/#TOKEN
APPLE_SHARED_ALBUM_URL=
APPLE_SHARED_ALBUM_TOKEN=
NEXT_PUBLIC_PHOTO_ALBUM_NAME=Family Album
NEXT_PUBLIC_PHOTO_INTERVAL_MS=12000

# Blink doorbell
BLINK_EMAIL=
BLINK_PASSWORD=
BLINK_CLIENT_ID=

# Weather (Open-Meteo — no API key)
MIRROR_LATITUDE=51.5074
MIRROR_LONGITUDE=-0.1278
MIRROR_LOCATION_LABEL=London

# Radio (Capital XTRA by default — override stream if needed)
NEXT_PUBLIC_RADIO_STATION_NAME=Capital XTRA
NEXT_PUBLIC_RADIO_STATION_TAGLINE=UK · Hip-Hop & R&B
NEXT_PUBLIC_RADIO_STREAM_URL=https://media-ssl.musicradio.com/CapitalXTRANationalMP3

# Guest Wi‑Fi card (QR joins the network on scan)
NEXT_PUBLIC_WIFI_LABEL=Guest Wi‑Fi
NEXT_PUBLIC_WIFI_SSID=DIGI-Guest
NEXT_PUBLIC_WIFI_PASSWORD=Jtech123!
NEXT_PUBLIC_WIFI_SECURITY=WPA

# News (BBC UK by default — no API key)
NEWS_FEED_URL=https://feeds.bbci.co.uk/news/uk/rss.xml
NEWS_FEED_LABEL=BBC News
NEWS_LIMIT=5

# Alexa / smart lights via webhook (Amazon has no simple public light API)
# Easiest path: IFTTT applet — If Webhook → Then Alexa (routine: lights on/off)
# Paste the IFTTT webhook URLs below:
LIGHTS_LABEL=Alexa lights
LIGHTS_ON_URL=
LIGHTS_OFF_URL=
LIGHTS_WEBHOOK_METHOD=POST
